generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
  connections  SocialConnection[]
  posts        Post[]
  snapshots    MetricSnapshot[]
  jobs         Job[]
  drafts       Draft[]
  hookLibrary  HookLibraryItem[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Phase 1 foresight - encrypted platform tokens live here
model SocialConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String
  externalAccountId String
  displayName       String?
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  scopes            String?
  status            String    @default("disconnected")
  lastSyncAt        DateTime?
  lastSyncError     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  posts             Post[]
  snapshots         MetricSnapshot[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId, platform])
}

model Post {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platformPostId String
  kind           String?
  caption        String?
  permalink      String?
  publishedAt    DateTime?
  raw            Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([connectionId, platformPostId])
  @@index([userId, publishedAt])
}

model MetricSnapshot {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  platform     String
  metricKey    String
  value        Float
  windowStart  DateTime?
  windowEnd    DateTime?
  capturedAt   DateTime          @default(now())
  raw          Json?

  @@index([userId, capturedAt])
  @@index([userId, platform, metricKey, capturedAt])
}

model Job {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  status         String    @default("pending")
  payload        Json
  idempotencyKey String?   @unique
  runAfter       DateTime  @default(now())
  attempts       Int       @default(0)
  lastError      String?
  lockedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([userId, createdAt])
}

/// Phase 5 - compose / schedule / publish drafts
model Draft {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String
  body            String
  goalTag         String?
  conversionNote  String?
  status          String    @default("draft")
  scheduledAt     DateTime?
  connectionId    String?
  publishedPostId String?
  sourceDraftId   String?
  sentimentLabel  String?
  sentimentScore  Float?
  sentimentNote   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status, scheduledAt])
  @@index([userId, createdAt])
}

/// Phase 6 - competitor hook library (AI-analyzed paste)
model HookLibraryItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  hook       String
  structure  String?
  cta        String?
  sourceHash String?
  tags       Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
