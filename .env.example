# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5432/pulseboard

# Sessions / OAuth state HMAC (min 16 chars; use 32+)
# Used for signed OAuth CSRF state (Phase 1). Session tokens are DB-hashed separately.
SESSION_SECRET=replace-with-long-random-string-min-32-chars
SESSION_TTL_DAYS=14
COOKIE_NAME=pulseboard_session
COOKIE_SECURE=false

# AES-256-GCM (32 bytes base64). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=info

# --- Phase 1: Instagram / Meta ---
# Create a Meta app, add Instagram Graph + Facebook Login, set redirect:
#   {APP_URL}/api/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
META_FB_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback
META_GRAPH_VERSION=v21.0
# Local/CI without Meta credentials:
META_USE_FIXTURES=false

# --- Phase 3: LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback
# Local/CI without LinkedIn credentials (independent of META_USE_FIXTURES):
LINKEDIN_USE_FIXTURES=false

# --- Phase 9: Threads ---
# Prefer dedicated Threads app IDs; falls back to META_APP_ID/SECRET if unset.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/oauth/threads/callback
THREADS_GRAPH_VERSION=v1.0
THREADS_USE_FIXTURES=false

# --- Phase 10: TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback
TIKTOK_USE_FIXTURES=false

# YouTube Data API v3 (Google OAuth)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
YOUTUBE_USE_FIXTURES=false

# --- Phase 6: AI / Gemini ---
# Fixture mode (default when no key): GEMINI_USE_FIXTURES=true
# Live: set GEMINI_API_KEY and GEMINI_USE_FIXTURES=false
GEMINI_USE_FIXTURES=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Scale seams ---
# RATE_LIMIT_BACKEND=memory
# CACHE_BACKEND=memory
# JOB_BACKEND=db
# REDIS_URL=
# DATABASE_POOL_URL=
# DIRECT_URL=
# Required for POST/GET /api/cron (global job drain):
# CRON_SECRET=
# MAX_SYNC_CONCURRENCY=1

# --- Phase 8: monitoring (optional) ---
# SENTRY_DSN=
