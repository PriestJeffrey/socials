# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
# Local / CI:
DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5432/pulseboard
# Docker Compose ignores this DATABASE_URL and builds an encoded URL inside the
# container from POSTGRES_* (safe for passwords containing @ : / #).
# POSTGRES_USER=pulseboard
# POSTGRES_PASSWORD=pulseboard
# POSTGRES_DB=pulseboard

# Sessions / OAuth state HMAC (min 16 chars; use 32+ random). No placeholders -
# known defaults like "replace-with-long-random-string-min-32-chars" are rejected.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=14
COOKIE_NAME=pulseboard_session
COOKIE_SECURE=false

# AES-256-GCM (32 bytes base64). Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=info

# --- Phase 1: Instagram / Meta ---
# Walkthrough: docs/live-accounts-setup.md
# Create a Meta app, add Instagram Graph + Facebook Login, set redirects:
#   {APP_URL}/api/oauth/instagram/callback
#   {APP_URL}/api/oauth/facebook/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
META_FB_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback
META_GRAPH_VERSION=v21.0
# true = local fixture OAuth/sync/publish (default in Docker). false = live Graph.
META_USE_FIXTURES=true

# --- Phase 3: LinkedIn ---
# Walkthrough: docs/live-accounts-setup.md
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback
# true = fixtures (default in Docker). false = live OAuth + UGC publish.
LINKEDIN_USE_FIXTURES=true

# --- Phase 4: X (manual compose only) ---
# No OAuth / API keys. Compose + copy from /x - never auto-publish.

# --- Phase 6: AI / Gemini ---
# Fixture mode (default when no key): GEMINI_USE_FIXTURES=true
# Live: set GEMINI_API_KEY and GEMINI_USE_FIXTURES=false
GEMINI_USE_FIXTURES=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Scale seams ---
# RATE_LIMIT_BACKEND=memory
# CACHE_BACKEND=memory
# JOB_BACKEND=db
# REDIS_URL=
# DATABASE_POOL_URL=
# DIRECT_URL=
# Required for POST/GET /api/cron (global job drain). Strong random ≥16 chars.
# Placeholders like "dev-cron-secret-change-me" are rejected (503).
# CRON_SECRET=
# MAX_SYNC_CONCURRENCY=1

# --- Phase 8: monitoring (optional) ---
# SENTRY_DSN=
